MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6b7ef6aa56733164e86cfdd87312f948, type: 3}
  m_Name: CoopMinigameCatalog
  m_EditorClassIdentifier: Assembly-CSharp::SmartCampus.Coop.Minigames.CoopMinigameCatalogConfig
  entries:
  - minigameIndex: 0
    displayName: "Las visiones del jard\xEDn"
    description: Cada dispositivo decide con un gesto si una imagen pertenece o no
      al jardin. La puntuacion se comparte entre todo el grupo.
    sceneName: GardenImageVotingMinigame
  - minigameIndex: 1
    displayName: "Ecos de anta\xF1o"
    description: Un dispositivo reproduce un sonido y el resto compara palabras diferentes
      para decidir en grupo cual debe pulsarse.
    sceneName: AudioWordConsensusMinigame
  - minigameIndex: 2
    displayName: "\xBFQue sabe a que?"
    description: Adivina una planta entre todos con historial compartido, autocompletado
      y pistas de atributos tipo Loldle.
    sceneName: CollaborativePlantGuessMinigame
  - minigameIndex: 3
    displayName: "\xBFQue sabe a que?"
    description: Minijuego cooperativo con informacion parcial repartida entre dispositivos.
    sceneName: DistributedPairsMinigame
  - minigameIndex: 4
    displayName: Minijuego 5 - Taxonomia del jardin del olfato
    description: Clasifica en grupo cada planta entre decoracion, alimentacion y
      curacion con feedback comun y nota compartida.
    sceneName: GardenSmellTaxonomyMinigame
  - minigameIndex: 5
    displayName: Minijuego 6 - Pista, foto y planta
    description: Un dispositivo fotografia una planta guiado por una pista y otro
      la adivina por nombre comun.
    sceneName: PlantPhotoRelayMinigame
